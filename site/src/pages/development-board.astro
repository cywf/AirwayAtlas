---
import Layout from '../layouts/Layout.astro';
import DevBoard from '../components/DevelopmentBoard';
---

<Layout title="Development Board">
  <div class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-4xl font-bold mb-4">Development Board</h1>
      <p class="text-lg opacity-80 mb-4">
        Track the progress of ongoing work and planned features
      </p>
      <div class="flex gap-2">
        <a
          href="https://github.com/cywf/AirwayAtlas/projects"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary btn-sm"
        >
          View on GitHub
        </a>
        <a
          href="https://github.com/cywf/AirwayAtlas/issues"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline btn-sm"
        >
          All Issues
        </a>
      </div>
    </div>

    <DevBoard client:load />
  </div>
</Layout>
