---
import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL || '/AirwayAtlas';
---

<Layout title="Home">
  <div class="hero min-h-[50vh] bg-gradient-to-br from-primary/20 to-secondary/20">
    <div class="hero-content text-center">
      <div class="max-w-4xl">
        <h1 class="text-5xl font-bold mb-4">✈️ AirwayAtlas 🌎</h1>
        <p class="text-xl mb-8">
          Your go-to resource for airport city data in North America & the Caribbean
        </p>
        <p class="text-lg mb-8">
          Interactive map 🗺️, powerful search 🔍, and easy-to-integrate RESTful API 🚀
        </p>
        <div class="flex gap-4 justify-center flex-wrap">
          <a href={`${baseUrl}/map`} class="btn btn-primary btn-lg">
            View Map
          </a>
          <a
            href="https://github.com/cywf/AirwayAtlas"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline btn-lg"
          >
            GitHub
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="container mx-auto px-4 py-12">
    <!-- Features Section -->
    <section class="mb-16">
      <h2 class="text-3xl font-bold mb-8 text-center">Features</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="card bg-base-200 shadow-xl">
          <div class="card-body items-center text-center">
            <div class="text-5xl mb-4">📊</div>
            <h3 class="card-title">Comprehensive Database</h3>
            <p>200+ airport cities in the USA, Canada, Mexico, and the Caribbean</p>
          </div>
        </div>

        <div class="card bg-base-200 shadow-xl">
          <div class="card-body items-center text-center">
            <div class="text-5xl mb-4">🗺️</div>
            <h3 class="card-title">Interactive Map</h3>
            <p>Easy visualization of airport locations and control centers</p>
          </div>
        </div>

        <div class="card bg-base-200 shadow-xl">
          <div class="card-body items-center text-center">
            <div class="text-5xl mb-4">🔍</div>
            <h3 class="card-title">Powerful Search</h3>
            <p>Search by airport code, city, state, or region</p>
          </div>
        </div>

        <div class="card bg-base-200 shadow-xl">
          <div class="card-body items-center text-center">
            <div class="text-5xl mb-4">🚀</div>
            <h3 class="card-title">RESTful API</h3>
            <p>Seamless integration with third-party applications</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Start Section -->
    <section class="mb-16">
      <h2 class="text-3xl font-bold mb-8 text-center">Quick Start</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="card bg-base-200 shadow-xl">
          <div class="card-body">
            <h3 class="card-title">View the Demo</h3>
            <ol class="list-decimal list-inside space-y-2">
              <li>Visit the <a href={`${baseUrl}/map`} class="link link-primary">interactive map</a></li>
              <li>Search for airports by code, city, or region</li>
              <li>Click markers to view detailed information</li>
            </ol>
          </div>
        </div>

        <div class="card bg-base-200 shadow-xl">
          <div class="card-body">
            <h3 class="card-title">Run Locally</h3>
            <div class="mockup-code text-sm">
              <pre data-prefix="$"><code>git clone https://github.com/cywf/AirwayAtlas.git</code></pre>
              <pre data-prefix="$"><code>cd AirwayAtlas</code></pre>
              <pre data-prefix="$"><code>npm install</code></pre>
              <pre data-prefix="$"><code>npm run build</code></pre>
              <pre data-prefix="$"><code>npm run serve</code></pre>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Links Section -->
    <section class="mb-16">
      <h2 class="text-3xl font-bold mb-8 text-center">Quick Links</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <a
          href="https://github.com/cywf/AirwayAtlas/issues"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline"
        >
          📋 Issues
        </a>
        <a
          href="https://github.com/cywf/AirwayAtlas/discussions"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline"
        >
          💬 Discussions
        </a>
        <a
          href="https://github.com/cywf/AirwayAtlas/releases"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline"
        >
          🚀 Releases
        </a>
        <a
          href="https://github.com/cywf/AirwayAtlas/blob/main/LICENSE.md"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline"
        >
          📄 License
        </a>
        <a href={`${baseUrl}/map`} class="btn btn-outline">
          🗺️ Interactive Map
        </a>
        <a href={`${baseUrl}/docs`} class="btn btn-outline">
          📚 Documentation
        </a>
        <a href={`${baseUrl}/statistics`} class="btn btn-outline">
          📊 Statistics
        </a>
        <a href={`${baseUrl}/create-issue`} class="btn btn-outline">
          ➕ Create Issue
        </a>
      </div>
    </section>

    <!-- Dataset Scope Section -->
    <section>
      <h2 class="text-3xl font-bold mb-8 text-center">Dataset Scope</h2>
      <div class="stats stats-vertical lg:stats-horizontal shadow w-full">
        <div class="stat">
          <div class="stat-figure text-primary">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              class="inline-block w-8 h-8 stroke-current"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
          </div>
          <div class="stat-title">Total Airports</div>
          <div class="stat-value text-primary">217</div>
          <div class="stat-desc">Across North America</div>
        </div>

        <div class="stat">
          <div class="stat-figure text-secondary">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              class="inline-block w-8 h-8 stroke-current"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"
              ></path>
            </svg>
          </div>
          <div class="stat-title">Regions Covered</div>
          <div class="stat-value text-secondary">4</div>
          <div class="stat-desc">USA, Canada, Mexico, Caribbean</div>
        </div>

        <div class="stat">
          <div class="stat-figure text-accent">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              class="inline-block w-8 h-8 stroke-current"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"
              ></path>
            </svg>
          </div>
          <div class="stat-title">Data Format</div>
          <div class="stat-value text-accent">JSON</div>
          <div class="stat-desc">Static, fast & lightweight</div>
        </div>
      </div>
    </section>
  </div>
</Layout>
