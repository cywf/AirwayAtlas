---
import Layout from '../layouts/Layout.astro';
import StatisticsLoader from '../components/StatisticsLoader';
---

<Layout title="Repository Statistics">
  <div class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-4xl font-bold mb-4">Repository Statistics</h1>
      <p class="text-lg opacity-80">
        Real-time insights into the AirwayAtlas repository activity and metrics
      </p>
    </div>

    <StatisticsLoader client:load />
  </div>
</Layout>
